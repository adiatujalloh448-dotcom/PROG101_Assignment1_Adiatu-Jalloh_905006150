<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="FLOW2"/>
        <attribute name="authors" value="MCS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-11-04 09:01:35 PM"/>
        <attribute name="created" value="TUNTO0RFU0tUT1AtMUdIMUpEODsyMDI2LTExLTA0OzA4OjM2OjA4IFBNOzI1MzQ="/>
        <attribute name="edited" value="TUNTO0RFU0tUT1AtMUdIMUpEODsyMDI2LTExLTA0OzA5OjAxOjM1IFBNOzE7MjYzNQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Welcome waste management officer&quot;" newline="True"/>
            <output expression="&quot;available reports are desplayed&quot;" newline="True"/>
            <output expression="&quot;please enter reportID&quot;" newline="True"/>
            <declare name="reportID" type="Integer" array="False" size=""/>
            <input variable="reportID"/>
            <output expression="&quot;select reportStatus: pending, in progress, or resolved&quot;" newline="True"/>
            <declare name="reportStatus" type="String" array="False" size=""/>
            <input variable="reportStatus"/>
            <declare name="moreReports" type="String" array="False" size=""/>
            <while expression="moreReports = true">
                <output expression="&quot;please select and process the next waste report&quot;" newline="True"/>
                <input variable="reportID"/>
                <output expression="&quot;enter the next reportID&quot;" newline="True"/>
                <output expression="&quot;are there more reports to process? Enter yes or no&quot;" newline="True"/>
            </while>
        </body>
    </function>
</flowgorithm>
